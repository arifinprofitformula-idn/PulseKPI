APP_NAME=PulseKPI
APP_ENV=local
APP_KEY=
# Set APP_DEBUG=false in production. Leaving it true exposes stack traces.
APP_DEBUG=true
APP_URL=http://pulsekpi.test
APP_BRAND_NAME=PulseKPI
APP_BRAND_TAGLINE="Performance Management Platform"
APP_BRAND_DESCRIPTION="Platform manajemen performa untuk KPI, assessment, approval, dan pelaporan."
APP_BRAND_LOGO_FULL=images/branding/pulsekpi-logo-full.png
APP_BRAND_LOGO_MARK=images/branding/pulsekpi-logo-mark.png
APP_BRAND_FAVICON=favicon.png
APP_BRAND_HERO_WAVE=resources/images/branding/hero-wave.svg
APP_BRAND_PRIMARY_COLOR=#0F9D8A
APP_BRAND_SECONDARY_COLOR=#1E4D8C
APP_BRAND_ACCENT_COLOR=#F59E0B
APP_BRAND_INK_COLOR=#0F172A

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pulsekpi
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
# Set SESSION_ENCRYPT=true in production to encrypt session data at rest.
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set SESSION_SECURE_COOKIE=true in production to require HTTPS for session cookies.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=pulsekpi

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Change all three SUPER_ADMIN_* values before running seeders in production.
SUPER_ADMIN_NAME="PulseKPI Super Admin"
SUPER_ADMIN_EMAIL=admin@pulsekpi.test
SUPER_ADMIN_PASSWORD=ChangeMe123!

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
